# ── LLM APIs ──────────────────────────────────
GOOGLE_API_KEY=your_gemini_api_key_here

# ── Search Tools (Free Tiers) ─────────────────
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id
GOOGLE_SEARCH_API_KEY=your_search_api_key
SERPAPI_KEY=your_serpapi_key_here

# ── Infrastructure ────────────────────────────
POSTGRES_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/a2a_marketplace
REDIS_URL=redis://localhost:6379

# ── Service Ports ─────────────────────────────
REGISTRY_PORT=9000
ORCHESTRATOR_PORT=8000
WEB_SEARCH_AGENT_PORT=8001
DATA_ANALYSIS_AGENT_PORT=8002
DOCUMENT_AGENT_PORT=8003
CODE_AGENT_PORT=8004

# ── Security ──────────────────────────────────
JWT_SECRET_KEY=your_generated_secret_here
A2A_BEARER_TOKEN=dev-bearer-token

# ── Environment ───────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# ── Gemini Models ─────────────────────────────
# Available: gemini-2.0-flash, gemini-2.0-flash-lite
AGENT_MODEL=gemini-flash-lite-latest
ORCHESTRATOR_MODEL=gemini-flash-latest