# .env.example

# ── LLM APIs ──────────────────────────────────
GOOGLE_API_KEY=your_gemini_api_key_here
# Get free key at: https://aistudio.google.com/

# ── Search Tools (Free Tiers) ─────────────────
# Option A: SerpAPI - 100 searches/month free
SERPAPI_KEY=your_serpapi_key_here

# Option B: Google Custom Search - 100/day free  
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id
GOOGLE_SEARCH_API_KEY=your_search_api_key

# ── Infrastructure ────────────────────────────
POSTGRES_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/a2a_marketplace
REDIS_URL=redis://localhost:6379

# ── Service Ports ─────────────────────────────
REGISTRY_PORT=9000
ORCHESTRATOR_PORT=8000
WEB_SEARCH_AGENT_PORT=8001
DATA_ANALYSIS_AGENT_PORT=8002
DOCUMENT_AGENT_PORT=8003
CODE_AGENT_PORT=8004

# ── Security ──────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_generated_secret_here
A2A_BEARER_TOKEN=your_generated_bearer_token_here

# ── Environment ───────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=DEBUG